---
import TimelineLayout from "../layouts/TimelineLayout.astro";
---

<TimelineLayout>
  <!-- Main Scrollable Wrapper -->
  <div id="main-wrapper" class="w-screen h-screen overflow-x-hidden overflow-y-auto bg-black flex flex-col justify-between selection:bg-[#39FF14]/30 scroll-smooth relative z-0">
    
    <!-- Optimized Animated Background Effects -->
    <div class="fixed inset-0 z-[-1] pointer-events-none overflow-hidden">
      <!-- Radial gradient for a subtle center glow -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(57,255,20,0.15)_0%,transparent_70%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom,rgba(0,240,255,0.05)_0%,transparent_50%)]"></div>
      <!-- Animated Grid -->
      <div class="absolute inset-[-100%] h-[200%] bg-[linear-gradient(rgba(57,255,20,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(57,255,20,0.1)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:linear-gradient(to_bottom,transparent,black_70%)] retro-grid-bg"></div>
    </div>
    
    <!-- Top Nav Header -->
    <header class="w-full max-w-6xl mx-auto px-4 mt-6 md:mt-8 reveal reveal-fade-down">
      <div class="bg-[#090d16]/40 backdrop-blur-xl text-white rounded-2xl shadow-[0_4px_30px_rgba(0,0,0,0.5)] py-4 px-6 flex items-center border border-white/10 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-[#39FF14]/10 to-[#00F0FF]/10 opacity-50"></div>
        <div class="flex items-center gap-3 w-full justify-between relative z-10">
          <div class="flex items-center gap-4">
            <!-- Icon -->
            <div class="w-10 h-10 rounded-full border border-[#39FF14]/50 bg-[#39FF14]/10 flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(57,255,20,0.2)] text-[#39FF14]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <!-- Title -->
            <h1 class="font-display font-bold text-sm md:text-lg text-white tracking-widest uppercase">
              Retro<span class="text-[#39FF14]">Spec</span>
            </h1>
          </div>
          <span class="museum-label text-zinc-400 text-[10px] tracking-widest shrink-0 hidden sm:inline-block font-mono border border-white/10 px-3 py-1 rounded-full bg-black/50">
            GROUP #4 EXHIBIT
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="w-full max-w-6xl mx-auto px-4 py-12 md:py-20 flex-grow flex flex-col items-center">
      
      <!-- Hero Section -->
      <section class="text-center w-full max-w-4xl mx-auto mb-20 md:mb-32 reveal reveal-scale-up">
        <span class="inline-block px-4 py-1.5 rounded-full bg-[#39FF14]/10 border border-[#39FF14]/30 text-[#39FF14] font-mono text-[10px] tracking-[0.2em] mb-6 shadow-[0_0_15px_rgba(57,255,20,0.2)]">
          10 MINUTE EXPERIENCE
        </span>
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-display font-black text-transparent bg-clip-text bg-gradient-to-br from-white via-zinc-200 to-zinc-500 uppercase tracking-tight leading-tight mb-8 drop-shadow-2xl">
          The Evolution of <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#39FF14] to-[#00F0FF] filter drop-shadow-[0_0_20px_rgba(57,255,20,0.4)]">Computer Graphics</span>
        </h2>
        <p class="text-zinc-400 text-sm md:text-lg max-w-2xl mx-auto leading-relaxed mb-10 font-sans">
          A highly immersive, interactive 3D timeline exploring the symbiotic relationship between hardware leaps and graphical fidelity.
        </p>
        
        <!-- Massive CTA -->
        <a 
          href={`${import.meta.env.BASE_URL}/timeline`.replace('//', '/')} 
          class="relative inline-flex items-center justify-center gap-3 px-8 py-4 md:px-10 md:py-5 bg-white text-black rounded-full font-display font-bold text-sm md:text-base tracking-[0.2em] uppercase transition-all duration-300 hover:scale-105 active:scale-95 group overflow-hidden"
        >
          <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-[#39FF14] to-[#00F0FF] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <span class="relative z-10 group-hover:text-black transition-colors">Enter the Timeline</span>
          <svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </section>

      <!-- Bento Box Layout -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full items-stretch">
        
        <!-- About the Project (Spans 2 cols) -->
        <section class="md:col-span-2 bg-[#090d16]/60 backdrop-blur-xl rounded-3xl p-8 border border-white/10 hover:border-[#39FF14]/30 transition-colors duration-500 shadow-2xl relative overflow-hidden group reveal reveal-fade-up">
          <div class="absolute top-0 right-0 w-64 h-64 bg-[#39FF14]/10 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/4 group-hover:bg-[#39FF14]/20 transition-colors duration-700"></div>
          <div class="relative z-10 h-full flex flex-col justify-between">
            <div>
              <span class="inline-block w-2 h-2 rounded-full bg-[#39FF14] mb-4 shadow-[0_0_10px_#39FF14]"></span>
              <h3 class="font-display text-xl md:text-2xl font-bold text-white uppercase tracking-wider mb-4">About the Project</h3>
              <p class="text-zinc-400 text-sm md:text-base leading-relaxed mb-6">
                This interactive virtual exhibit was created as the final project for <strong>CSARCH2</strong> (Computer Architecture 2). 
                Our goal is to explore how foundational concepts—from simple ASCII grids to hardware-accelerated ray tracing pipelines—have continuously pushed the boundaries of what computers can render.
              </p>
            </div>
          </div>
        </section>

        <!-- Technologies Used (1 col) -->
        <section class="md:col-span-1 bg-[#090d16]/60 backdrop-blur-xl rounded-3xl p-8 border border-white/10 hover:border-[#f59e0b]/30 transition-colors duration-500 shadow-2xl relative overflow-hidden group reveal reveal-fade-left">
          <div class="absolute top-0 right-0 w-48 h-48 bg-[#f59e0b]/10 rounded-full blur-[60px] translate-y-1/2 translate-x-1/2 group-hover:bg-[#f59e0b]/20 transition-colors duration-700"></div>
          <div class="relative z-10">
            <span class="inline-block w-2 h-2 rounded-full bg-[#f59e0b] mb-4 shadow-[0_0_10px_#f59e0b]"></span>
            <h3 class="font-display text-xl font-bold text-white uppercase tracking-wider mb-6">Tech Stack</h3>
            <div class="flex flex-wrap gap-2">
              {['Astro', 'React', 'Tailwind', 'Framer Motion', 'Three.js'].map((tech) => (
                <span class="px-3 py-1.5 bg-black/40 border border-white/5 rounded-lg text-xs text-zinc-300 font-mono hover:bg-white/10 transition-colors cursor-default">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </section>

        <!-- Exhibit Overview: Decades Carousel -->
        <section class="md:col-span-3 bg-[#090d16]/60 backdrop-blur-xl rounded-3xl p-8 border border-white/10 shadow-2xl mt-4 reveal reveal-fade-up">
          <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-3">
              <span class="inline-block w-2 h-2 rounded-full bg-[#B026FF] shadow-[0_0_10px_#B026FF]"></span>
              <h3 class="font-display text-xl md:text-2xl font-bold text-white uppercase tracking-wider">Exhibit Overview</h3>
            </div>
            <p class="text-xs text-zinc-500 font-mono hidden md:block tracking-widest">SCROLL TO EXPLORE &rarr;</p>
          </div>
          
          <!-- Horizontal scrolling container -->
          <div class="w-full overflow-x-auto pb-6 hide-scrollbar cursor-grab active:cursor-grabbing snap-x snap-mandatory">
            <div class="flex gap-4 w-max">
              <!-- Cards -->
              {[
                { era: '1960s', color: '#22c55e', desc: 'The dawn of vector graphics and Sketchpad.', img: 'placeholder-1960.jpg' },
                { era: '1970s', color: '#ef4444', desc: 'Raster graphics emerge and color arrives.', img: 'placeholder-1970.jpg' },
                { era: '1980s', color: '#f59e0b', desc: 'The golden age of arcade graphics and early 3D.', img: 'placeholder-1980.jpg' },
                { era: '1990s', color: '#3b82f6', desc: 'Hardware acceleration and the 3D revolution.', img: 'placeholder-1990.jpg' },
                { era: '2000s', color: '#06b6d4', desc: 'Programmable shaders change everything.', img: 'placeholder-2000.jpg' },
                { era: '2010s', color: '#10b981', desc: 'Realism, PBR, and the rise of compute.', img: 'placeholder-2010.jpg' },
                { era: '2020s', color: '#a855f7', desc: 'Real-time ray tracing and AI generation.', img: 'placeholder-2020.jpg' }
              ].map((item) => (
                <div class="w-[280px] shrink-0 bg-black/50 border border-white/5 rounded-2xl overflow-hidden hover:border-white/20 transition-all duration-300 group snap-center">
                  <!-- Image Placeholder (User can swap the src later) -->
                  <div class="w-full h-40 bg-zinc-900 relative overflow-hidden flex items-center justify-center">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent z-10"></div>
                    <!-- Replace the src below when you have images! -->
                    <!-- <img src={`/images/${item.img}`} alt={`${item.era} Graphics`} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 opacity-60" /> -->
                    <div class="text-zinc-700 font-mono text-xs z-0">[ Image Area: {item.img} ]</div>
                    
                    <h4 class="absolute bottom-4 left-4 z-20 font-display text-3xl font-black text-transparent opacity-80" style={`-webkit-text-stroke: 1px ${item.color};`}>
                      {item.era}
                    </h4>
                  </div>
                  <div class="p-5">
                    <p class="text-sm text-zinc-400 leading-relaxed font-sans group-hover:text-zinc-200 transition-colors">
                      {item.desc}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Meet the Team -->
        <section class="md:col-span-3 mt-4 reveal reveal-fade-up">
          <div class="flex items-center gap-3 mb-6 px-2">
            <span class="inline-block w-2 h-2 rounded-full bg-[#00F0FF] shadow-[0_0_10px_#00F0FF]"></span>
            <h3 class="font-display text-lg font-bold text-white uppercase tracking-wider">Meet RetroSpec</h3>
          </div>
          
          <div class="flex flex-wrap gap-4">
            {
              [
                "Bueno, Jonathan R.",
                "Dela Cruz, Louiz Alfredo DV.",
                "Ibañez, Kane Joshua",
                "Ignacio, Miguel Angelo",
                "Solomon, Adonis Mikel"
              ].map((name) => (
                <div class="flex-grow md:flex-grow-0 flex items-center gap-3 bg-[#090d16]/60 backdrop-blur-xl border border-white/10 rounded-xl p-3 md:pr-6 hover:border-[#00F0FF]/40 hover:-translate-y-1 transition-all duration-300 shadow-lg group">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-zinc-800 to-black border border-white/10 flex items-center justify-center shadow-inner group-hover:shadow-[0_0_15px_rgba(0,240,255,0.2)]">
                    <svg class="w-4 h-4 text-zinc-500 group-hover:text-[#00F0FF] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                  </div>
                  <div>
                    <h4 class="text-xs md:text-sm font-display font-semibold text-zinc-200 group-hover:text-white transition-colors">{name}</h4>
                    <p class="text-[9px] text-zinc-500 font-mono tracking-widest mt-0.5">GROUP #4</p>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

      </div>
    </main>

    <!-- Bottom Footer Bar -->
    <footer class="w-full py-8 px-4 mt-auto reveal reveal-fade-in">
      <div class="max-w-6xl mx-auto flex flex-col items-center gap-6">
        
        <hr class="w-full border-white/5" />

        <!-- AI/LLM Disclosure -->
        <div class="w-full max-w-2xl bg-black/40 rounded-xl border border-white/5 p-5 md:p-6 text-center">
          <div class="flex items-center justify-center gap-2 mb-3">
            <div class="w-1.5 h-1.5 rounded-full bg-[#f59e0b] shadow-[0_0_6px_#f59e0b]"></div>
            <span class="font-display text-[10px] text-[#f59e0b] tracking-[0.2em] uppercase font-bold">Disclosure on AI / LLM Usage</span>
          </div>
          <p class="text-zinc-500 text-[10px] md:text-xs leading-relaxed font-mono">
            This project utilized AI tools as development aids. All historical content, creative direction, and architectural choices are the team's own work. Full disclosure available in the 
            <!-- Updated link to deployment-v2 branch -->
            <a href="https://github.com/kimsajaang/case-study-project-grp-4-csarch2/tree/deployment-v2#disclosure-on-the-use-of-ai--llm" 
               target="_blank" 
               class="text-[#39FF14]/80 hover:text-[#39FF14] underline underline-offset-4 transition-colors font-semibold">project README</a>.
          </p>
        </div>

        <!-- Attribution -->
        <div class="flex flex-col items-center gap-2 text-center pb-4">
          <span class="font-display text-zinc-600 text-[9px] md:text-[10px] tracking-[0.3em] uppercase">
            CSARCH2 Virtual Exhibit &mdash; "Computer Architecture is Forever"
          </span>
          <span class="font-mono text-zinc-700 text-[8px] md:text-[9px] tracking-[0.2em]">
            RetroSpec (Group #4) &bull; Built in 2024
          </span>
        </div>
      </div>
    </footer>

  </div>
</TimelineLayout>

<script>
  // Setup intersection observer for scroll reveal animations
  const setupReveal = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          // Optional: observer.unobserve(entry.target) if you only want it to animate once
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px"
    });

    document.querySelectorAll('.reveal').forEach((el) => {
      observer.observe(el);
    });
  };

  // Run on load
  setupReveal();

  // Horizontal scroll drag functionality for the decades slider
  const slider = document.querySelector('.hide-scrollbar') as HTMLElement;
  let isDown = false;
  let startX: number;
  let scrollLeft: number;

  if(slider) {
    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      slider.classList.add('active');
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });
    slider.addEventListener('mouseleave', () => {
      isDown = false;
      slider.classList.remove('active');
    });
    slider.addEventListener('mouseup', () => {
      isDown = false;
      slider.classList.remove('active');
    });
    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 2; // Scroll-fast
      slider.scrollLeft = scrollLeft - walk;
    });
  }
</script>

<style>
  @keyframes gridScroll {
    0% { transform: translateY(0); }
    100% { transform: translateY(40px); }
  }
  .retro-grid-bg {
    animation: gridScroll 1.5s linear infinite;
    will-change: transform;
  }
  
  /* Hide scrollbar for Chrome, Safari and Opera */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  /* Reveal Animations */
  .reveal {
    opacity: 0;
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal.active {
    opacity: 1;
    transform: none;
  }
  
  .reveal-fade-up { transform: translateY(40px); }
  .reveal-fade-down { transform: translateY(-40px); }
  .reveal-fade-left { transform: translateX(40px); }
  .reveal-fade-right { transform: translateX(-40px); }
  .reveal-scale-up { transform: scale(0.95); }
  .reveal-fade-in { transform: none; }
</style>
