---
import TimelineLayout from '../layouts/TimelineLayout.astro';
import IntroTV from '../components/IntroTV.jsx';
import CuratorBoard from '../components/CuratorBoard.jsx';
import * as Era1960s from '../content/eras/1960s.mdx';
import * as Era1970s from '../content/eras/1970s.mdx';
import * as Era1980s from '../content/eras/1980s.mdx';
import * as Era1990s from '../content/eras/1990s.mdx';
import * as Era2000s from '../content/eras/2000s.mdx';
import * as Era2010s from '../content/eras/2010s.mdx';
import * as Era2020s from '../content/eras/2020s.mdx';
---

<TimelineLayout>
  <IntroTV client:load />

  {/* Header Title */}
  <header class="fixed top-8 left-12 z-50 pointer-events-none">
    <div class="flex items-center gap-2 text-[10px] font-mono tracking-widest text-[#39FF14] mb-2">
      <div class="w-2 h-2 rounded-full bg-[#39FF14] animate-pulse shadow-[0_0_10px_#39FF14]"></div>
      <span class="uppercase">Active Terminal</span>
    </div>
    <h1 class="text-3xl font-sans font-bold text-white tracking-tight uppercase drop-shadow-[0_0_15px_rgba(255,255,255,0.3)]">
      How Computers <br/>
      <span class="text-[#39FF14] drop-shadow-[0_0_20px_#39FF14]">Learned to See</span>
    </h1>
    <p class="text-zinc-500 font-mono text-xs mt-2 uppercase tracking-widest">
      The Living Terminal Timeline
    </p>
  </header>

  {/* Continuous Scrolling Timeline */}
  <main id="timeline" class="relative w-screen h-screen bg-[#020305] overflow-x-auto overflow-y-hidden flex items-center hide-scrollbar">
    
    {/* Atmospheric Background Glow */}
    <div class="fixed inset-0 w-full h-full pointer-events-none z-0 overflow-hidden">
      <div class="absolute top-1/4 left-1/4 w-[50vw] h-[50vh] bg-[#39FF14]/5 rounded-full blur-[100px] mix-blend-screen opacity-50 animate-pulse"></div>
      <div class="absolute bottom-1/4 right-1/4 w-[40vw] h-[40vh] bg-[#39FF14]/5 rounded-full blur-[120px] mix-blend-screen opacity-30"></div>
    </div>

    {/* Full-Screen Immersive 3D Floor Grid */}
    <div 
      class="fixed bottom-0 left-0 w-full h-[60vh] pointer-events-none z-0" 
      style="
        background-size: 80px 80px;
        background-image: 
          linear-gradient(to right, rgba(57, 255, 20, 0.1) 1px, transparent 1px), 
          linear-gradient(to bottom, rgba(57, 255, 20, 0.1) 1px, transparent 1px);
        transform: perspective(800px) rotateX(75deg);
        transform-origin: top center;
        mask-image: radial-gradient(ellipse at top, black 0%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse at top, black 0%, transparent 70%);
      "
    ></div>

    {/* Immersive 3D Ceiling Grid (VR Tunnel Effect) */}
    <div 
      class="fixed top-0 left-0 w-full h-[60vh] pointer-events-none z-0 opacity-40" 
      style="
        background-size: 80px 80px;
        background-image: 
          linear-gradient(to right, rgba(57, 255, 20, 0.1) 1px, transparent 1px), 
          linear-gradient(to bottom, rgba(57, 255, 20, 0.1) 1px, transparent 1px);
        transform: perspective(800px) rotateX(-75deg);
        transform-origin: bottom center;
        mask-image: radial-gradient(ellipse at bottom, black 0%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse at bottom, black 0%, transparent 70%);
      "
    ></div>

    {/* Cavernous Vignette Overlay */}
    <div class="fixed inset-0 w-full h-full pointer-events-none z-50 shadow-[inset_0_0_200px_rgba(0,0,0,1)]"></div>

    {/* Infinite Background Timeline Line */}
    <div class="fixed top-1/2 left-0 w-[10000px] h-[3px] bg-gradient-to-r from-transparent via-[#39FF14]/30 to-transparent pointer-events-none z-0 blur-[2px]"></div>
    <div class="fixed top-1/2 left-0 w-[10000px] h-[1px] bg-[#39FF14]/20 pointer-events-none z-0"></div>

    <div class="flex items-center pl-[10vw] pr-32 gap-32 md:gap-64 min-w-max relative z-10 py-24">
      {/* Intro Core */}
      <CuratorBoard client:load />

      {/* Era Nodes */}
      <Era1960s.Content />
      <Era1970s.Content />
      <Era1980s.Content />
      <Era1990s.Content />
      <Era2000s.Content />
      <Era2010s.Content />
      <Era2020s.Content />
    </div>
  </main>
</TimelineLayout>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.02);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>

<script>
  document.addEventListener('wheel', (e) => {
    const timeline = document.getElementById('timeline');
    if (!timeline) return;

    // Only convert vertical scroll to horizontal
    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
      e.preventDefault();
      timeline.scrollLeft += e.deltaY;
    }
  }, { passive: false });
</script>
