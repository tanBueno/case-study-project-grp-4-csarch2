---
import TimelineLayout from "../layouts/TimelineLayout.astro";
---

<TimelineLayout>
  <!-- Main Scrollable Wrapper -->
  <div id="main-wrapper" class="w-screen h-screen overflow-y-auto japanese-cubes-bg flex flex-col justify-between selection:bg-[#39FF14]/30 scroll-smooth">
    
    <!-- Top Nav Header -->
    <header class="w-full max-w-5xl mx-auto px-4 mt-6 md:mt-8">
      <div class="bg-[#090d16]/75 backdrop-blur-md text-white rounded-lg shadow-[0_4px_30px_rgba(0,0,0,0.5)] py-3 px-5 flex items-center border border-[#39FF14]/20">
        <div class="flex items-center gap-3 w-full justify-between">
          <div class="flex items-center gap-3 overflow-hidden">
            <!-- Circle containing Home Icon -->
            <div class="w-8 h-8 rounded-full border border-[#39FF14]/30 bg-[#39FF14]/5 flex items-center justify-center shrink-0 shadow-[0_0_10px_rgba(57,255,20,0.15)] text-[#39FF14]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
            </div>
            <!-- Title & Attribution -->
            <h1 class="font-display font-semibold text-xs md:text-sm text-zinc-100 tracking-wider uppercase truncate">
              How Computers Learned to See: The Evolution of Graphics
            </h1>
          </div>
          <span class="museum-label text-zinc-400 text-[9px] tracking-widest shrink-0 hidden sm:inline-block font-mono">
            by Exhibit Curator
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="w-full max-w-5xl mx-auto px-4 py-8 flex-grow flex items-center justify-center">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 w-full items-start">
        
        <!-- Left Column: Table of Contents -->
        <section class="md:col-span-1 bg-[#090d16]/75 backdrop-blur-md text-white rounded-lg p-5 shadow-[0_4px_30px_rgba(0,0,0,0.5)] border border-white/5">
          <h2 class="museum-label text-xs tracking-[0.2em] font-semibold text-zinc-300 uppercase">Table of contents</h2>
          <hr class="border-white/10 my-2.5" />
          <nav>
            <ol class="space-y-3 font-mono text-xs text-zinc-300 list-none pl-0">
              <li>
                <a href="#about-project" class="hover:text-[#39FF14] transition-colors duration-200 flex items-baseline gap-1.5 group">
                  <span class="text-[#39FF14]/50 group-hover:text-[#39FF14]">01 //</span>
                  <span>About the Project</span>
                </a>
              </li>
              <li>
                <a href="#enter-timeline" class="hover:text-[#39FF14] transition-colors duration-200 flex items-baseline gap-1.5 group">
                  <span class="text-[#39FF14]/50 group-hover:text-[#39FF14]">02 //</span>
                  <span>Enter the Timeline</span>
                </a>
              </li>
              <li>
                <a href="#exhibit-overview" class="hover:text-[#39FF14] transition-colors duration-200 flex items-baseline gap-1.5 group">
                  <span class="text-[#39FF14]/50 group-hover:text-[#39FF14]">03 //</span>
                  <span>Exhibit Overview</span>
                </a>
              </li>
              <li>
                <a href="#meet-the-team" class="hover:text-[#39FF14] transition-colors duration-200 flex items-baseline gap-1.5 group">
                  <span class="text-[#39FF14]/50 group-hover:text-[#39FF14]">04 //</span>
                  <span>Meet the Team</span>
                </a>
              </li>
              <li>
                <a href="#technologies" class="hover:text-[#39FF14] transition-colors duration-200 flex items-baseline gap-1.5 group">
                  <span class="text-[#39FF14]/50 group-hover:text-[#39FF14]">05 //</span>
                  <span>Technologies Used</span>
                </a>
              </li>
            </ol>
          </nav>
        </section>

        <!-- Right Column: Cards -->
        <div class="md:col-span-3 flex flex-col gap-6">
          
          <!-- Card 1: Welcome -->
          <section class="bg-[#090d16]/75 backdrop-blur-md text-white rounded-lg p-6 shadow-[0_4px_30px_rgba(0,0,0,0.5)] border border-white/5 text-center">
            <h2 class="text-2xl md:text-3xl font-display font-bold text-white uppercase tracking-wider">
              <span class="text-[#39FF14] drop-shadow-[0_0_15px_rgba(57,255,20,0.4)]">Welcome</span> to the Exhibit
            </h2>
            <p class="museum-label text-zinc-400 mt-2 text-[10px] tracking-[0.2em]">
              by Exhibit Curator &bull; 10 minute experience
            </p>
          </section>

          <!-- Card 2: Immersive Info & Overview -->
          <section class="bg-[#090d16]/75 backdrop-blur-md text-white rounded-lg p-6 md:p-8 shadow-[0_4px_30px_rgba(0,0,0,0.5)] border border-white/5">
            
            <p class="text-zinc-300 text-sm md:text-base leading-relaxed mb-6 font-sans">
              We have designed a highly immersive, interactive 3D timeline experience for this exhibit.
            </p>

            <!-- About the Project -->
            <div id="about-project" class="scroll-mt-6 mb-12 bg-gradient-to-br from-white/[0.03] to-transparent p-6 md:p-8 rounded-xl border border-white/10 shadow-lg relative overflow-hidden group">
              <div class="absolute inset-0 bg-[#00F0FF]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
              <span class="inline-block bg-[#00F0FF]/20 text-[#00F0FF] border border-[#00F0FF]/30 px-3 py-1 rounded-sm font-display text-[10px] tracking-[0.2em] uppercase mb-5 shadow-[0_0_10px_rgba(0,240,255,0.15)] relative z-10">
                About the Project
              </span>
              <p class="text-zinc-300 text-sm md:text-base leading-relaxed mb-4 relative z-10 font-sans font-light">
                This interactive virtual exhibit was created as the final project for <strong class="text-white font-medium">CSARCH2</strong> (Computer Architecture 2). 
                Our goal is to explore the symbiotic relationship between hardware evolution and graphical fidelity. 
              </p>
              <p class="text-zinc-400 text-xs md:text-sm leading-relaxed relative z-10 font-sans">
                As you journey through the decades, you will witness how foundational concepts—from simple ASCII grids to hardware-accelerated ray tracing pipelines—have continuously pushed the boundaries of what computers can render.
              </p>
            </div>

            <!-- Enter the Timeline -->
            <div id="enter-timeline" class="scroll-mt-6">
              <h3 class="museum-label text-xs text-[#00F0FF] tracking-[0.25em] border-b border-white/10 pb-2 mb-4 font-semibold uppercase">
                Enter the Timeline
              </h3>
              <p class="text-zinc-400 text-xs md:text-sm mb-5">
                Click the button below to launch the immersive exhibit.
              </p>
              
              <!-- Launch Button -->
              <a 
                href={`${import.meta.env.BASE_URL}/timeline`.replace('//', '/')} 
                class="inline-flex items-center gap-2.5 px-6 py-3 bg-gradient-to-r from-[#39FF14] to-[#00F0FF] text-zinc-950 rounded-full text-xs md:text-sm font-display font-bold tracking-[0.15em] uppercase transition-all duration-300 hover:scale-105 active:scale-95 shadow-[0_0_20px_rgba(57,255,20,0.3)] hover:shadow-[0_0_30px_rgba(57,255,20,0.6)] cursor-pointer"
              >
                <span>Launch Immersive 3D Timeline</span>
              </a>
            </div>

            <!-- Exhibit Overview -->
            <div id="exhibit-overview" class="scroll-mt-6 mt-12 bg-black/20 p-6 md:p-8 rounded-xl border border-white/5">
              <!-- Blue text highlight container -->
              <span class="inline-block bg-[#B026FF]/20 text-[#B026FF] border border-[#B026FF]/30 px-3 py-1 rounded-sm font-display text-[10px] tracking-[0.2em] uppercase mb-6 shadow-[0_0_10px_rgba(176,38,255,0.15)]">
                Exhibit Overview
              </span>
              
              <p class="text-zinc-300 text-sm md:text-base mb-6 font-light">
                In this exhibit, you will travel through the decades:
              </p>

              <!-- Decades List (Timeline Style) -->
              <div class="relative pl-4 border-l border-white/10 space-y-6 mb-8">
                <div class="relative">
                  <span class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full bg-[#22c55e] shadow-[0_0_8px_#22c55e]"></span>
                  <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
                    <strong class="font-semibold font-display text-[#22c55e] tracking-wider text-sm md:text-base block mb-1">1960s</strong> The dawn of vector graphics and Sketchpad.
                  </p>
                </div>
                <div class="relative">
                  <span class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full bg-[#ef4444] shadow-[0_0_8px_#ef4444]"></span>
                  <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
                    <strong class="font-semibold font-display text-[#ef4444] tracking-wider text-sm md:text-base block mb-1">1970s</strong> Raster graphics emerge and color arrives.
                  </p>
                </div>
                <div class="relative">
                  <span class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full bg-[#f59e0b] shadow-[0_0_8px_#f59e0b]"></span>
                  <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
                    <strong class="font-semibold font-display text-[#f59e0b] tracking-wider text-sm md:text-base block mb-1">1980s</strong> The golden age of arcade graphics and early 3D.
                  </p>
                </div>
                <div class="relative">
                  <span class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full bg-[#3b82f6] shadow-[0_0_8px_#3b82f6]"></span>
                  <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
                    <strong class="font-semibold font-display text-[#3b82f6] tracking-wider text-sm md:text-base block mb-1">1990s</strong> Hardware acceleration and the 3D revolution.
                  </p>
                </div>
                <div class="relative">
                  <span class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full bg-[#06b6d4] shadow-[0_0_8px_#06b6d4]"></span>
                  <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
                    <strong class="font-semibold font-display text-[#06b6d4] tracking-wider text-sm md:text-base block mb-1">2000s</strong> Programmable shaders change everything.
                  </p>
                </div>
                <div class="relative">
                  <span class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full bg-[#10b981] shadow-[0_0_8px_#10b981]"></span>
                  <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
                    <strong class="font-semibold font-display text-[#10b981] tracking-wider text-sm md:text-base block mb-1">2010s</strong> Realism, PBR, and the rise of compute.
                  </p>
                </div>
                <div class="relative">
                  <span class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full bg-[#a855f7] shadow-[0_0_8px_#a855f7]"></span>
                  <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
                    <strong class="font-semibold font-display text-[#a855f7] tracking-wider text-sm md:text-base block mb-1">2020s</strong> Real-time ray tracing and AI generation.
                  </p>
                </div>
              </div>

              <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-[#00F0FF]/30 to-transparent my-6"></div>

              <p class="text-[#00F0FF] font-display font-medium text-xs md:text-sm tracking-[0.2em] uppercase text-center">
                Enjoy the journey!
              </p>
            </div>

            <!-- Meet the Team -->
            <div id="meet-the-team" class="scroll-mt-6 mt-12 pt-4">
              <span class="inline-block bg-[#39FF14]/20 text-[#39FF14] border border-[#39FF14]/30 px-3 py-1 rounded-sm font-display text-[10px] tracking-[0.2em] uppercase mb-6 shadow-[0_0_10px_rgba(57,255,20,0.15)]">
                Meet the Team (RetroSpec)
              </span>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {
                  [
                    "Bueno, Jonathan R.",
                    "Dela Cruz, Louiz Alfredo DV.",
                    "Ibañez, Kane Joshua",
                    "Ignacio, Miguel Angelo",
                    "Solomon, Adonis Mikel"
                  ].map((name) => (
                    <div class="flex items-center gap-4 bg-gradient-to-br from-white/[0.03] to-transparent border border-white/5 rounded-xl p-4 hover:border-[#39FF14]/50 hover:bg-white/[0.05] transition-all duration-300 group cursor-default shadow-lg hover:shadow-[0_0_20px_rgba(57,255,20,0.1)] hover:-translate-y-0.5">
                      <div class="w-10 h-10 rounded-full bg-black/50 border border-white/10 flex items-center justify-center shadow-inner group-hover:border-[#39FF14]/50 group-hover:shadow-[0_0_15px_rgba(57,255,20,0.3)] transition-all duration-300 relative overflow-hidden">
                        <div class="absolute inset-0 bg-[#39FF14] opacity-0 group-hover:opacity-20 transition-opacity duration-300"></div>
                        <svg class="w-5 h-5 text-zinc-500 group-hover:text-[#39FF14] transition-colors relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                      </div>
                      <div class="flex-grow">
                        <h4 class="text-sm font-display font-medium text-zinc-300 group-hover:text-white transition-colors">{name}</h4>
                        <p class="text-[10px] text-zinc-500 font-mono tracking-widest mt-0.5 group-hover:text-[#39FF14]/70 transition-colors">GROUP #4</p>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- Technologies Used -->
            <div id="technologies" class="scroll-mt-6 mt-12 pt-4 pb-4">
              <span class="inline-block bg-[#f59e0b]/20 text-[#f59e0b] border border-[#f59e0b]/30 px-3 py-1 rounded-sm font-display text-[10px] tracking-[0.2em] uppercase mb-6 shadow-[0_0_10px_rgba(245,158,11,0.15)]">
                Technologies Used
              </span>
              
              <div class="flex flex-wrap gap-2.5">
                {['Astro', 'React', 'Tailwind CSS', 'Framer Motion', 'GitHub Pages'].map((tech) => (
                  <span class="px-4 py-2 bg-gradient-to-b from-white/[0.05] to-transparent border border-white/10 rounded-full text-xs md:text-sm text-zinc-300 font-mono shadow-sm hover:border-[#f59e0b]/40 hover:text-[#f59e0b] transition-colors duration-300 cursor-default">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

          </section>
        </div>

      </div>
    </main>

    <!-- Bottom Footer Bar -->
    <footer class="w-full py-6 px-4">
      <div class="max-w-5xl mx-auto flex flex-col items-center gap-4">
        
        <!-- AI/LLM Disclosure -->
        <div class="w-full bg-[#090d16]/60 backdrop-blur-sm rounded-lg border border-white/5 p-4 md:p-5">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-1.5 h-1.5 rounded-full bg-[#f59e0b] shadow-[0_0_6px_#f59e0b]"></div>
            <span class="museum-label text-[9px] text-[#f59e0b]/80 tracking-[0.2em] uppercase font-semibold">Disclosure on the Use of AI / LLM</span>
          </div>
          <p class="text-zinc-500 text-[10px] md:text-xs leading-relaxed font-mono">
            This project utilized AI/LLM tools (Gemini, AI-assisted coding tools) as development aids for interactive component development, 
            CSS visual effects, deployment configuration, and documentation structuring. All historical content, creative direction, 
            design decisions, and architectural choices are the team's own work. AI tools served as development accelerators, 
            not as primary content authors. Full disclosure available in the 
            <a href="https://github.com/kimsajaang/case-study-project-grp-4-csarch2#disclosure-on-the-use-of-ai--llm" 
               target="_blank" 
               class="text-[#39FF14]/70 hover:text-[#39FF14] underline underline-offset-2 transition-colors">project README</a>.
          </p>
        </div>

        <!-- Attribution -->
        <div class="flex flex-col items-center gap-1.5">
          <span class="museum-label text-zinc-600 text-[8px] tracking-[0.25em]">
            CSARCH2 Virtual Exhibit &mdash; "Computer Architecture is Forever"
          </span>
          <span class="museum-label text-zinc-700 text-[7px] tracking-[0.2em]">
            RetroSpec (Group #4) &bull; Bueno &bull; Dela Cruz &bull; Ibañez &bull; Ignacio &bull; Solomon
          </span>
        </div>
      </div>
    </footer>

  </div>
</TimelineLayout>

<script>
  const wrapper = document.getElementById("main-wrapper");
  if (wrapper) {
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener("click", function(e) {
        e.preventDefault();
        const targetId = this.getAttribute("href")?.slice(1);
        if (targetId) {
          const targetElement = document.getElementById(targetId);
          if (targetElement) {
            targetElement.scrollIntoView({ behavior: "smooth" });
          }
        }
      });
    });
  }
</script>

<style>
  /* Dark Cyber 3D Isometric Repeating Cubes Background Pattern */
  .japanese-cubes-bg {
    background-color: #080c14;
    background-image: 
      linear-gradient(30deg, #020306 12%, transparent 12.5%, transparent 87%, #020306 87.5%, #020306),
      linear-gradient(150deg, #020306 12%, transparent 12.5%, transparent 87%, #020306 87.5%, #020306),
      linear-gradient(30deg, #020306 12%, transparent 12.5%, transparent 87%, #020306 87.5%, #020306),
      linear-gradient(150deg, #020306 12%, transparent 12.5%, transparent 87%, #020306 87.5%, #020306),
      linear-gradient(60deg, #141e30 25%, transparent 25.5%, transparent 75%, #141e30 75.5%, #141e30),
      linear-gradient(60deg, #141e30 25%, transparent 25.5%, transparent 75%, #141e30 75.5%, #141e30);
    background-size: 80px 140px;
    background-position: 0 0, 0 0, 40px 70px, 40px 70px, 0 0, 40px 70px;
  }
</style>
